{
  "name": "finance-calculator-app",
  "version": "1.0.0",
  "description": "Finance Calculator Application - Projeto Unificado",
  "main": "backend/server.js",
  "scripts": {
    "setup": "bash setup.sh",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "install": "npm install --prefix backend && npm install --prefix frontend",
    "fix-permissions": "chmod +x backend/node_modules/.bin/* frontend/node_modules/.bin/* 2>/dev/null || true",
    
    "dev": "npm run fix-permissions && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm start",
    "dev:frontend": "cd frontend && npm run dev",
    
    "build": "cd frontend && npm run build",
    "build:backend": "cd backend && npm install --production",
    "build:all": "npm run install && npm run build",
    
    "start": "NODE_ENV=production node backend/server.js",
    "start:dev": "npm run dev",
    
    "prestart": "npm run build"
  },
  "keywords": [
    "finance",
    "calculator",
    "react",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
