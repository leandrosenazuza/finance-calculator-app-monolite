{
  "name": "finance-calculator-app",
  "version": "1.0.0",
  "description": "Finance Calculator Application",
  "scripts": {
    "setup": "bash setup.sh",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "fix-permissions": "chmod +x backend/node_modules/.bin/* frontend/node_modules/.bin/* 2>/dev/null || true",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "start": "npm run fix-permissions && concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "dev": "npm run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

